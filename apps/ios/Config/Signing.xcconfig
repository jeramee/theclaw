// Shared iOS signing defaults for local development + CI.
#include "Version.xcconfig"

THECLAW_IOS_DEFAULT_TEAM = Y5PE65HELJ
THECLAW_IOS_SELECTED_TEAM = $(THECLAW_IOS_DEFAULT_TEAM)
THECLAW_DEVELOPMENT_TEAM = $(THECLAW_IOS_SELECTED_TEAM)
THECLAW_CODE_SIGN_STYLE = Automatic
THECLAW_APP_BUNDLE_ID = ai.theclaw.client
THECLAW_WATCH_APP_BUNDLE_ID = ai.theclaw.client.watchkitapp
THECLAW_WATCH_EXTENSION_BUNDLE_ID = ai.theclaw.client.watchkitapp.extension
THECLAW_ACTIVITY_WIDGET_BUNDLE_ID = ai.theclaw.client.activitywidget
THECLAW_WATCH_APP_PROFILE =
THECLAW_WATCH_EXTENSION_PROFILE =

// Local contributors can override this by running scripts/ios-configure-signing.sh.
// Keep include after defaults: xcconfig is evaluated top-to-bottom.
#include? "../.local-signing.xcconfig"
#include? "../LocalSigning.xcconfig"

CODE_SIGN_STYLE = $(THECLAW_CODE_SIGN_STYLE)
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = $(THECLAW_DEVELOPMENT_TEAM)

// Let Xcode manage provisioning for the selected local team unless a local override pins one.
PROVISIONING_PROFILE_SPECIFIER =
